{
  "name": "attention-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webcam-based eye tracking for wireframe and webpage attention studies",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/tests/run.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tests.mjs && node node_modules/.cache/tests.mjs",
    "fetch-model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
